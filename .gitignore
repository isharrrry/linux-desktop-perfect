# ============================================================================
# LinuxDesktopPerfect 版本控制边界（规则来源见 30-design/设计文档包/01 §7.3）
# 原则：可复算的产物一律不入库；入不入库取决于「能否用仓内命令重建」
# ============================================================================

# --- 上游快照（只读，可由 SNAPSHOT.json 的 extract_command 重建） ---
40-build/upstream/wpf/*
!40-build/upstream/wpf/SNAPSHOT.json
!40-build/upstream/wpf/.gitkeep

# --- 派生树与构建产物（ADR-002：applier 可再生） ---
40-build/build/
40-build/**/artifacts/
40-build/**/obj/
40-build/**/bin/
40-build/pack/out/
40-build/pack/*.nupkg
*.binlog
artifacts/
.dotnet/
.tools/

# --- 离线桩包（D-002；由 40-build/lock/make-stub-feed.mjs 重建） ---
40-build/lock/offline-feed/*.nupkg

# --- 判据读数与运行时缓存（08 §3.6：读数只追加、不入版本控制） ---
50-verify/读数/*
!50-verify/读数/.gitkeep
__pycache__/
*.pyc

# --- 自检临时件、日志、编辑器 ---
_selftest_*.md
*.log
*.tmp
*.swp
.vs/
.vscode/
.idea/
*.user

# --- 样本构建产物（派生：dotnet build 生成，可由 node 50-verify/build/build-sample.mjs 重建） ---
samples/**/bin/
samples/**/obj/

# --- 上游 framework pack 取件缓存（39 MB；取件命令见 40-build/lock/README.md） ---
40-build/lock/packs/*.nupkg
40-build/lock/packs/ref-extract/
# UIAutomation 引用（Ribbon 编译用；从已安装框架复制，不随仓分发）
40-build/lock/refs/

# --- pack 组装读数（生成物：由 node 40-build/pack/build-pack.mjs 重建） ---
40-build/pack/pack-report.json

# --- 构建期头文件缓存（libfreetype-dev / libharfbuzz-dev / libfontconfig1-dev 解包的 include；
#     不入库：由 make -C 40-build/text-stack headers 取件，单件 1.3 MB） ---
40-build/lock/headers/

# --- 判据侧工具与移植链的构建产物（可由 dotnet build / build-port.mjs 重建） ---
50-verify/**/bin/
50-verify/**/obj/
40-build/wpf-port/build-report.json
40-build/milcore-bridge/bridge-report.json
40-build/wpf-port/out/

# --- 依赖目录 ---
node_modules/

# --- AE 基线帧（本仓自产，机器相关；由 ae-compare.mjs --baseline 重建） ---
50-verify/render/baseline/
