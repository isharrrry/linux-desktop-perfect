<?xml version="1.0" encoding="utf-8"?>
<!--
  样本工程的包源：自产 Ref/Runtime pack 走本地 feed（40-build/pack/out），其余走 nuget.org。
  生成物不入库：feed 由 node 40-build/pack/build-pack.mjs 产出。
-->
<configuration>
  <packageSources>
    <clear />
    <add key="ldp-local" value="../40-build/pack/out" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
