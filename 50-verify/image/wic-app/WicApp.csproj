<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WIC 端到端验证应用（ACC-018 的"应用内解码"面）。
    为什么不用 7 个样本：样本只写 TargetFramework（ADR-006），而这条验证需要"加载一张真实 PNG
    并读出像素尺寸"的最小业务逻辑；放在判据侧（50-verify）比污染样本更干净。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>WicApp</AssemblyName>
    <RootNamespace>LdpVerify.Wic</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
