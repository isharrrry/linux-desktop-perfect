<!--
  System.Drawing.Common 的 **Unix 后端**，编成同名同强名称的程序集。
  源码来自 corefx release/3.1（见 SOURCE.md）—— .NET 6 之后上游删掉了 Unix 分支，
  而 WinForms 依赖它，所以必须自己编一份来替换运行时里的"只支持 Windows"的原版。
  强名称：PublicKey 取自原版 dll 的 AssemblyDef（.NET 的公钥，token=cc7b13ffcd2ddd51），
  用 PublicSign 重签 ⇒ 程序集身份与 System.Windows.Forms 的引用一致。
-->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Drawing.Common</AssemblyName>
    <RootNamespace>System.Drawing</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>/tmp/msft-drawing.snk</AssemblyOriginatorKeyFile>
    <NoWarn>$(NoWarn);CS0618;CS0809;CS0169;CS0414;CS0649;CS1591;CS8632;CS0219;CS8981;CA1416;CA1420;SYSLIB0003;CS8002</NoWarn>
    <DefineConstants>$(DefineConstants);Unix;NETCOREAPP;NETCOREAPP3_0_OR_GREATER;DRAWING_NAMESPACE</DefineConstants>
    <EnablePInvokeAnalyzer>false</EnablePInvokeAnalyzer>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <!-- 全部源码，排除 Windows 专用分支 -->
    <!-- corefx 的约定：X.cs 是 Windows/共享，X.Unix.cs 是 Unix。
         两个都存在时，X.cs 是 Windows 实现 ⇒ 必须排除（否则同名类型重复定义）。 -->
        <Compile Include="src/**/*.cs" Exclude="src/**/*.Windows.cs" />
    <!-- 同一类型在多文件里各定义一份（corefx 用 Configurations.props 三选一）⇒ 只留一份 -->
      <Compile Remove="src/SRDescriptionAttribute.cs" />
      <Compile Remove="src/System/Drawing/Printing/DefaultPrintController.cs" />
      <Compile Remove="src/System/Drawing/Printing/InvalidPrinterException.Serializable.cs" />
      <Compile Remove="src/System/Drawing/Printing/InvalidPrinterException.Core.cs" />
      <Compile Remove="src/misc/ExternDll.cs" />
      <Compile Remove="src/System/Drawing/ToolboxBitmapAttribute.cs" />
      <Compile Remove="src/System/Drawing/Drawing2D/AdjustableArrowCap.cs" />
  </ItemGroup>
</Project>
