<!--
  【ACC-024】`System.Printing` 的 **api cycle-breaker**。
  为什么需要：`ReachFramework` 与 `PresentationFramework` 互相依赖，
  而 `PresentationFramework` 又要用 `System.Printing` 的 `PrintTicket`/`PrintQueue` 等。
  上游的做法（见 Documentation/cycle-breakers.md）是发一个**只含类型声明**的
  `AssemblyName=System.Printing` 程序集，交给 impl-cycle 引用 —— 这样：
    · impl-cycle（AssemblyName=PresentationFramework）不必编 System.Printing 的类型 ⇒ 不会有 CS0433；
    · ReachFramework 可以同时引用真 System.Printing（运行时）和这个声明集（编译期）而类型不冲突
      **前提是两者程序集身份一致**（同为 System.Printing，同公钥）。
  这里把上游 cycle-breakers/ 下的 System.Printing / Xps 声明**全部编进来**。
-->
<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(MSBuildThisFileDirectory)../../../Linux/build/Directory.Upstream.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Printing</AssemblyName>
    <RootNamespace>System.Printing</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0618;CS0809;CS0169;CS0414;CS0649;CS1591;CS8632;CS0219;CS8981;CA1416;CA1420;WPF0001;CS8002;CS3016;CS0067;CS0108;CS0114</NoWarn>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>$(WpfLinuxRoot)src/Linux/build/keys/WcpPublicKey.snk</AssemblyOriginatorKeyFile>
    <DefineConstants>$(DefineConstants);REACHFRAMEWORK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UpstreamWpfRoot)src/Microsoft.DotNet.Wpf/cycle-breakers/ReachFramework/System.Printing.*.cs" />
    <Compile Include="$(UpstreamWpfRoot)src/Microsoft.DotNet.Wpf/cycle-breakers/ReachFramework/System.Windows.Xps.Packaging.*.cs" />
    <Compile Include="$(UpstreamWpfRoot)src/Microsoft.DotNet.Wpf/cycle-breakers/ReachFramework/System.Windows.Xps.Serialization.*.cs" />
    <!-- PrintQueue 改用 System.Printing.internals.cs 那份（官方 ref） -->
    <!-- 【ACC-024】ReachFramework 用到 System.Printing 的**内部**类型（XpsPrintStream / ILegacyDevice），
         它们在 System.Printing 的 ref 程序集里单独一个文件，而 cycle-breaker 那组没有。
         漏了它 ReachFramework 报 CS0246「XpsPrintStream/ILegacyDevice 找不到」。 -->
    <Compile Include="$(UpstreamWpfRoot)src/Microsoft.DotNet.Wpf/src/System.Printing/ref/System.Printing.internals.cs" />
    <Compile Include="$(UpstreamWpfRoot)src/Microsoft.DotNet.Wpf/src/Shared/RefAssemblyAttrs.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="WindowsBase"><HintPath>$(WpfLinuxRoot)src/Microsoft.DotNet.Wpf.Linux/src/WindowsBase/bin/$(WpfLinuxSelfBuiltConfiguration)/WindowsBase.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Xaml"><HintPath>$(WpfLinuxRoot)src/Microsoft.DotNet.Wpf.Linux/src/System.Xaml/bin/$(WpfLinuxSelfBuiltConfiguration)/System.Xaml.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PresentationCore"><HintPath>$(WpfLinuxRoot)src/Microsoft.DotNet.Wpf.Linux/src/PresentationCore/bin/$(WpfLinuxSelfBuiltConfiguration)/PresentationCore.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
