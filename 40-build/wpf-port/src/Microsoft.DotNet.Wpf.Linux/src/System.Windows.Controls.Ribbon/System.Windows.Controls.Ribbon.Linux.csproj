<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(MSBuildThisFileDirectory)../../../Linux/build/Directory.Upstream.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>System.Windows.Controls.Ribbon</AssemblyName>
    <RootNamespace>System.Windows.Controls.Ribbon</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <NoWarn>$(NoWarn);0618;CS3016;CS0067;CS0169;CS0414;CS0649;CS1591;CS8632;CS0219;CS8981;CA1416;CA1420;WPF0001</NoWarn>
    <DefineConstants>RIBBON_IN_FRAMEWORK;WINDOWS_BASE_OR_PC</DefineConstants>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnablePInvokeAnalyzer>false</EnablePInvokeAnalyzer>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <!-- 公钥按**上游 InternalsVisibleTo 的指定**选：PresentationFramework 的
         `BuildInfo.SystemWindowsControlsRibbon` = `PublicKey={DEVDIV_PUBLIC_KEY_STRING}`（ECMA 公钥），
         用 WCP 签名会 CS0281「公钥与 IVT 指定公钥不匹配」并连带 CS0115（友元不可见）。 -->
    <AssemblyOriginatorKeyFile>$(WpfLinuxRoot)src/Linux/build/keys/EcmaPublicKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Xaml"><HintPath>$(WpfLinuxRoot)src/Microsoft.DotNet.Wpf.Linux/src/System.Xaml/bin/$(WpfLinuxSelfBuiltConfiguration)/System.Xaml.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="WindowsBase"><HintPath>$(WpfLinuxRoot)src/Microsoft.DotNet.Wpf.Linux/src/WindowsBase/bin/$(WpfLinuxSelfBuiltConfiguration)/WindowsBase.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="PresentationCore"><HintPath>$(WpfLinuxRoot)src/Microsoft.DotNet.Wpf.Linux/src/PresentationCore/bin/$(WpfLinuxSelfBuiltConfiguration)/PresentationCore.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="PresentationFramework"><HintPath>$(WpfLinuxRoot)src/Microsoft.DotNet.Wpf.Linux/src/PresentationFramework/bin/$(WpfLinuxSelfBuiltConfiguration)/PresentationFramework.dll</HintPath><Private>true</Private></Reference>
    <Reference Include="PresentationFramework.Classic"><HintPath>$(WpfLinuxRoot)src/Microsoft.DotNet.Wpf.Linux/src/PresentationFramework.Classic/bin/$(WpfLinuxSelfBuiltConfiguration)/PresentationFramework.Classic.dll</HintPath><Private>true</Private></Reference>
  </ItemGroup>
  <!-- Ribbon 的 UIAutomation 依赖：走上游 ref 包里的 UIAutomationProvider/Types（纯托管，运行时已随框架分发） -->
  <ItemGroup>
    <Reference Include="UIAutomationTypes"><HintPath>$(WpfLinuxRoot)../lock/refs/UIAutomationTypes.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UIAutomationProvider"><HintPath>$(WpfLinuxRoot)../lock/refs/UIAutomationProvider.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
