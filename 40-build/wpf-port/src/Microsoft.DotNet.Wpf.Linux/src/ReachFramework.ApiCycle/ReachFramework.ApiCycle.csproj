<!--
  【ACC-024 / K-043】`ReachFramework` 的 **api cycle-breaker**（AssemblyName=ReachFramework）。
  为什么需要：`System.Printing` 里的 `PrintTicket` 在**运行时**是一个 TypeRef → 指向 `ReachFramework`
  （真正的定义在 `ReachFramework/PrintConfig/PrtTicket_Public_Simple.cs`）。
  而 `PresentationFramework`（impl-cycle）不能引用 `ReachFramework` 的实现（循环），
  只能引用这个**只含声明**的 `ReachFramework.dll` —— 于是它看到的 `PrintTicket`
  与 `ReachFramework` 实现里的**是同一个类型**。
  上游对应件：`cycle-breakers/ReachFramework/ReachFramework-PresentationFramework-api-cycle.csproj`
  与 `ReachFramework-System.Printing-api-cycle.csproj`（两者 AssemblyName 都是 ReachFramework）。
-->
<Project>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <Import Project="$(MSBuildThisFileDirectory)../../../Linux/build/Directory.Upstream.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>ReachFramework</AssemblyName>
    <RootNamespace>ReachFramework</RootNamespace>
    <LangVersion>latest</LangVersion>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS0618;CS0809;CS0169;CS0414;CS0649;CS1591;CS8632;CS0219;CS8981;CA1416;CA1420;WPF0001;CS8002;CS3016;CS0067;CS0108;CS0114</NoWarn>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <SignAssembly>true</SignAssembly>
    <PublicSign>true</PublicSign>
    <AssemblyOriginatorKeyFile>$(WpfLinuxRoot)src/Linux/build/keys/WcpPublicKey.snk</AssemblyOriginatorKeyFile>
    <DefineConstants>$(DefineConstants);REACHFRAMEWORK</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.cs" />
    <Compile Include="$(UpstreamWpfRoot)src/Microsoft.DotNet.Wpf/cycle-breakers/ReachFramework/System.Printing.*.cs" />
    <Compile Include="$(UpstreamWpfRoot)src/Microsoft.DotNet.Wpf/cycle-breakers/ReachFramework/System.Windows.Xps.*.cs" />
    <Compile Include="$(UpstreamWpfRoot)src/Microsoft.DotNet.Wpf/src/Shared/RefAssemblyAttrs.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="WindowsBase"><HintPath>$(WpfLinuxRoot)src/Microsoft.DotNet.Wpf.Linux/src/WindowsBase/bin/$(WpfLinuxSelfBuiltConfiguration)/WindowsBase.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Xaml"><HintPath>$(WpfLinuxRoot)src/Microsoft.DotNet.Wpf.Linux/src/System.Xaml/bin/$(WpfLinuxSelfBuiltConfiguration)/System.Xaml.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="PresentationCore"><HintPath>$(WpfLinuxRoot)src/Microsoft.DotNet.Wpf.Linux/src/PresentationCore/bin/$(WpfLinuxSelfBuiltConfiguration)/PresentationCore.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
